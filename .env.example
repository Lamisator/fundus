# ---------------------------------------------------------------- required
# Password of the bundled Postgres (also used to build DATABASE_URL).
POSTGRES_PASSWORD=change-me-to-something-long

# ---------------------------------------------------------------- basics
# Public URL. Optional: when empty it is derived from each request
# (X-Forwarded-Proto / -Host are honoured), which is fine behind Traefik.
FUNDUS_BASE_URL=
FUNDUS_SITE_NAME=Fundus
# Where the container port is published (ignored by the Traefik overlay).
FUNDUS_BIND=127.0.0.1:8080
# Hostname for deploy/compose.traefik.yml.
FUNDUS_HOST=kb.example.com
# UID/GID that owns ./data on the host (see `id -u`, `id -g`).
FUNDUS_UID=1000
FUNDUS_GID=1000

# First admin. Leave empty to finish setup in the browser with the one-time
# token printed in `docker compose logs fundus`.
FUNDUS_ADMIN_USER=
FUNDUS_ADMIN_PASSWORD=

# Username + password login (set to false for SSO/passkey-only installs).
FUNDUS_PASSWORD_LOGIN=true
FUNDUS_SESSION_DAYS=30
FUNDUS_MAX_UPLOAD_MB=50

# ---------------------------------------------------------------- passkeys
# Leave empty to derive the relying party from the Host header. Pin them in
# production so passkeys stay bound to one domain:
FUNDUS_RP_ID=
# Comma-separated list of allowed origins, e.g. https://kb.example.com
FUNDUS_RP_ORIGIN=

# ---------------------------------------------------------------- SSO (Zitadel / OIDC)
# Zitadel: create a project + "Web" application, auth method "PKCE" (no
# secret) or "Code" (with secret), redirect URI
#   https://kb.example.com/auth/oidc/callback
FUNDUS_OIDC_ISSUER=
FUNDUS_OIDC_CLIENT_ID=
FUNDUS_OIDC_CLIENT_SECRET=
# Optional; derived from FUNDUS_BASE_URL or the request when empty.
FUNDUS_OIDC_REDIRECT_URL=
FUNDUS_OIDC_SCOPES=openid profile email
FUNDUS_OIDC_BUTTON_LABEL=Sign in with Zitadel
# Create unknown users on first SSO login (else an admin must create them;
# they are linked by username or verified e-mail).
FUNDUS_OIDC_AUTO_CREATE=true
FUNDUS_OIDC_DEFAULT_ROLE=editor
# Only accept users of this Zitadel organisation (primary domain).
FUNDUS_OIDC_ALLOWED_DOMAIN=
# Map Zitadel project roles (admin / editor / viewer, optionally prefixed
# with "fundus-") to Fundus roles on every login. Users without one of these
# roles are refused. Leave empty to manage roles in Fundus instead.
FUNDUS_OIDC_ROLE_CLAIM=
#FUNDUS_OIDC_ROLE_CLAIM=urn:zitadel:iam:org:project:roles
